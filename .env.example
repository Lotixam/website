APP_NAME=Lotixam
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Prod mutualisé : voir .env.production.example et docs/deployment-lws.md
APP_URL=https://lotixam.fr
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
# En Docker Compose : mysql. En local sans Docker : 127.0.0.1
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lotix2767472
DB_USERNAME=lotix2767472
DB_PASSWORD=

# Docker Compose (service mysql)
MYSQL_ROOT_PASSWORD=
MYSQL_PUBLISH_PORT=3307

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# En prod HTTPS : true (évite les cookies de session en clair sur http).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Formulaire public /contact : nombre max de PJ et taille max par fichier (ko)
CONTACT_MAX_ATTACHMENTS=20
CONTACT_MAX_ATTACHMENT_KB=10240
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@lotixam.fr
MAIL_FROM_NAME=Lotixam
MAIL_TO=xavier.espinar@lotixam.fr

# Local HTTP : même base qu’APP_URL. Prod : https://lotixam.fr
SITE_URL=http://localhost
# Prod : true ; local HTTP : false
SESSION_SECURE_COOKIE=false
MAIL_FROM=noreply@lotixam.fr

VITE_APP_NAME="${APP_NAME}"
